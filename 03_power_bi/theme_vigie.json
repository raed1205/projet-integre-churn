{
  "name": "VIGIE — Groupe BI 5",
  "dataColors": ["#14213D", "#D62839", "#2A9D8F", "#F4A261", "#457B9D", "#6B7280", "#8D99AE", "#E76F51"],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#14213D",
  "good": "#2A9D8F",
  "neutral": "#F4A261",
  "bad": "#D62839",
  "maximum": "#D62839",
  "center": "#F4A261",
  "minimum": "#2A9D8F",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#14213D" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#14213D" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#1F2937" },
    "callout": { "fontFace": "Segoe UI", "fontSize": 26, "color": "#14213D" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#FAFAF7" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#14213D" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E9ECEF" } }, "radius": 10 }],
        "visualHeader": [{ "show": false }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#14213D" } }, "fontSize": 26 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#6B7280" } }, "fontSize": 10 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#14213D" } }, "textSize": 10 }],
        "items": [{ "fontColor": { "solid": { "color": "#1F2937" } }, "textSize": 10 }]
      }
    }
  }
}
